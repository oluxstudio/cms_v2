#!/usr/bin/env bash
# Push a local template project into the CMS: rsync the source into staging,
# then run the full intake pipeline (lint gate → publish → fonts/assets →
# preview build → refresh applied sites).
#
# CONTRACT — ADDITIVE: creates anything new (pages, blocks, fields,
# collections, forms, products, services) but never overwrites or deletes
# owner work. Use ./mirror-template when the project must win outright.
#
#   ./sync-template graceway              full deploy (~2-3 min, rebuilds shell)
#   ./sync-template graceway --no-build   content-only update (fast)
#   ./sync-template graceway --force      deploy despite lint errors
set -euo pipefail
KEY="${1:?usage: ./sync-template <key> [extra template:deploy flags]}"; shift || true
SRC="$HOME/development/olux-studio/templates/$KEY"
[ -d "$SRC" ] || { echo "✗ no such template source: $SRC"; exit 1; }

# Preflight: stray root-owned files (from any root-run deploy or build) make
# the rsync below and the publish/build steps fail with EACCES — normalise
# ownership BEFORE touching anything.
docker exec backend-cms-app-1 sh -c "chown -R sail:sail /var/www/html/templates /var/www/html/resources/templates /var/www/html/storage/app/import-$KEY /var/www/html/public/nuxt-preview 2>/dev/null" || true

rsync -a --delete \
  --exclude node_modules --exclude .nuxt --exclude .output --exclude .git \
  --exclude '.env*' --exclude .mcp.json --exclude scripts --exclude dist \
  --exclude pack --exclude '*Zone.Identifier' \
  "$SRC/" "$HOME/development/olux-studio/backend/storage/app/import-$KEY/" \
  || { echo "✗ copy into the CMS import folder failed — nothing was deployed"; exit 1; }

docker exec -u sail backend-cms-app-1 php artisan template:deploy "$KEY" \
  --from="/var/www/html/storage/app/import-$KEY" "$@"
