APP_NAME=Olux
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://cms.oluxstudio.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (Sail dev / production compose): host is the "mysql" service.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=olux_cms
DB_USERNAME=olux
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev: mailpit (host "mailpit", port 1025). Production: real SMTP creds.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@oluxstudio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Choose 'anthropic' | 'deepseek' | 'ollama' (local, free, no key needed).
LLM_DRIVER=deepseek

# Anthropic Claude — required when LLM_DRIVER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# DeepSeek — required when LLM_DRIVER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama — required when LLM_DRIVER=ollama
# Install: https://ollama.com  |  then: ollama pull deepseek-v2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-v2.5:7b

# ── Platform billing (account subscriptions) ─────────────────────────────────
# YOUR Stripe account — separate from any per-site keys stored in the DB.
# Empty = dev fallback (instant plan switching, no payment).
STRIPE_PLATFORM_SECRET=
STRIPE_PLATFORM_WEBHOOK_SECRET=

# ── Go-live publishing (client custom domains) ───────────────────────────────
# What client domains point their DNS at — the server's public IP (A record)
# or a hostname (CNAME). Shown in go-live instructions + used by Verify DNS.
PLATFORM_DNS_TARGET=
# The platform's own hostnames (never treated as a client site). APP_URL's
# host is always included automatically. Production: cms.oluxstudio.com
PLATFORM_HOSTS=

# ── Flux UI (composer.fluxui.dev auth — only if flux-pro is installed) ───────
FLUX_USERNAME=
FLUX_LICENSE_KEY=
